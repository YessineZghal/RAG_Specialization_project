# Copy this file to .env and adjust as needed.
# All values below are the defaults used if the variable is unset.

# ---------------------------------------------------------------------------
# Ollama (local, open-source model serving)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Embedding backend: "ollama" (default, no extra deps) or "sentence-transformers"
# (requires `uv sync --extra sentence-transformers`)
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=ollama
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Generation backend: "ollama" (default) or "extractive" (no LLM at all —
# returns the top retrieved chunk verbatim; used by offline tests/CI)
# ---------------------------------------------------------------------------
GENERATION_BACKEND=ollama

# ---------------------------------------------------------------------------
# Vector store backend used by the pipeline: "memory" (default, in-process
# numpy store) or "qdrant" (requires `uv sync --extra qdrant` + a running
# Qdrant instance, see docker-compose.yml)
# ---------------------------------------------------------------------------
VECTOR_STORE_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=naive_rag_level1

# ---------------------------------------------------------------------------
# Chunking + retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3

# ---------------------------------------------------------------------------
# Level 1 dataset — open-source, loaded at runtime via Hugging Face `datasets`
# (nothing is bundled in this repo; see 01-naive-rag/README.md#dataset)
# ---------------------------------------------------------------------------
HF_DATASET_NAME=rag-datasets/rag-mini-wikipedia
HF_DATASET_CONFIG=text-corpus
HF_DATASET_SPLIT=passages
